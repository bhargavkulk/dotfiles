# This is Git's per-user configuration file.
[user]
	name = Bhargav Kulkarni
	email = bhargavkishork@gmail.com
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[bash]
	showInformativeStatus = true
[init]
	defaultBranch = main
[credential "https://ampcode.com"]
	helper = !amp git-credential-helper
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[diff]
	algorithm = histogram
	mnemonicPrefix = true
	renames = true
[push]
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[merge]
	conflictstyle = zdiff3
[core]
	fsmonitor = false
	untrackedCache = true
